# ─── Base de datos (MySQL / MariaDB) ───
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:3306/BASE
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/citas"

# ─── Auth.js ───
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
# URL pública de la app (sin barra final)
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# En Hostinger (detrás de proxy) debe ser true
AUTH_TRUST_HOST=true

# ─── Correo SMTP (Nodemailer) ───
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
# true para el puerto 465 (SSL), false para 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER="info@livingriverllc.com"
SMTP_PASSWORD=""
MAIL_FROM="Living River <info@livingriverllc.com>"
# Si es true, los correos se escriben en la consola en lugar de enviarse (desarrollo)
MAIL_DRY_RUN=false

# ─── Tareas programadas ───
# Token que debe enviar el cron job: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="cambia-esto-por-otro-valor-aleatorio"

# ─── Opcional ───
# Orígenes extra permitidos para server actions si hay un proxy que cambia el Host (separados por comas)
SERVER_ACTIONS_ALLOWED_ORIGINS=""
